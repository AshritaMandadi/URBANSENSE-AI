# UrbanSense AI - Frontend Environment Variables
#
# Local Development:
# Leave empty or set to http://localhost:8000.
# When empty, Vite's development proxy handles /api and /health requests to localhost:8000.
VITE_API_BASE_URL=

# Production Deployment (Vercel):
# Set this to your deployed FastAPI backend URL without trailing slash.
# Example:
# VITE_API_BASE_URL=https://urbansense-api.onrender.com
# VITE_API_BASE_URL=https://urbansense-backend.railway.app

