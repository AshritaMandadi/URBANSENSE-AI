# UrbanSense AI - Environment Configuration

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins for Frontend Access
# Comma-separated list of domains that can call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Regex for dynamic preview domains (e.g., all Vercel deployments)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Compute Device Override ('mps' for Apple Silicon, 'cuda' for NVIDIA, 'cpu' for CPU)
# Leave blank for auto-detection
DEVICE=

# Path to custom-trained YOLO11n road damage weights
# Default: models/road_damage/best.pt
ROAD_DAMAGE_MODEL_PATH=models/road_damage/best.pt

# Path to general COCO object detection weights
GENERAL_MODEL_PATH=yolo11n.pt

# Database URL and Persistent Storage Directory
# In Docker / Render persistent disk: DATA_DIR=/app/data
DATA_DIR=data
DATABASE_URL=sqlite:///./data/urbansense.db

# Ultralytics cache directory (writable directory required for cloud deployments)
YOLO_CONFIG_DIR=/tmp

# Maximum Video Upload Size (in Megabytes)
MAX_UPLOAD_SIZE_MB=150

# Optional Automated Remote Model Provisioning URLs
# Set these if you want the container to download missing model weights automatically on startup
# ROAD_DAMAGE_MODEL_URL=https://your-bucket.com/models/best.pt
# GENERAL_MODEL_URL=https://your-bucket.com/models/yolo11n.pt
# MODEL_DOWNLOAD_TOKEN=your-optional-token
